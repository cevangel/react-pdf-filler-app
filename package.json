{
  "name": "react-pdf-filler-app",
  "version": "1.0.0",
  "description": "A React app for filling PDF forms for physical therapy evaluations",
  "scripts": {
    "install:all": "npm install && cd client-vite && npm install && cd ../server && npm install",
    "dev": "cd client-vite && npm run dev",
    "dev:server": "cd server && npm start",
    "build": "cd client-vite && npm run build",
    "lint": "cd client-vite && npm run lint",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.11"
  }
}
